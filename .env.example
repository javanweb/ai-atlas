# GEMINI_API_KEY: Required for Gemini AI API calls.
# Get a free key at https://aistudio.google.com/apikey
# SECURITY: never commit a real key here — put it in .env (gitignored).
GEMINI_API_KEY="PASTE_NEW_KEY_HERE"

# APP_URL: The URL where this applet is hosted.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# JINA_API_KEY: کلید Jina AI برای جستجوی بصری با بردار چندرسانه‌ای
# گرفتن کلید: https://jina.ai/api-dashboard/key-manager
JINA_API_KEY="PASTE_JINA_KEY_HERE"
VISUAL_SEARCH_EMBEDDING_PROVIDER="jina"
# jina-clip-v1 → ۷۶۸ بُعد، ۱۰۰۰ توکن/تصویر، ایندکس ~۱۶ دقیقه (پیش‌فرض)
# jina-clip-v2 → ۱۰۲۴ بُعد، ۴۰۰۰ توکن/تصویر، ایندکس ~۶۵ دقیقه (کیفیت ریزبینانه‌ی بهتر)
JINA_MODEL="jina-clip-v1"
# نمای بردار: "full" = تصویر کامل (پیشنهادشده — در آزمون عکس واقعی بهتر است)
#               "object" = جسم بریده‌شده از پس‌زمینه
# تغییر این مقدار باعث بازسازی خودکار کامل ایندکس می‌شود.
JINA_VIEWS="full"
JINA_TOKEN_BUDGET_PER_MIN="100000"
# ابعاد ارسال به Jina (۲۲۴ → ۱۰۰۰ توکن/تصویر؛ بزرگ‌تر → ۴۰۰۰ توکن)
JINA_MAX_PX="224"
# تعداد کارگر موازی ایندکس‌سازی
VISUAL_SEARCH_INDEX_CONCURRENCY="4"
# توکن ادمین برای نقاط پایانی داخلی (کالیبراسیون). اگر خالی باشد، این
# نقطه‌های پایانی فقط از loopback در دسترس‌اند.
VISUAL_SEARCH_ADMIN_TOKEN=""
